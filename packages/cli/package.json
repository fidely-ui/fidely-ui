{
  "name": "@fidely-ui/cli",
  "version": "1.1.0",
  "description": "Fidely UI CLI for scaffolding projects and generating UI component snippets.",
  "type": "module",
  "main": "./dist/esm/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/esm/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf --no-glob ./dist",
    "build": "pnpm clean && tsup --config tsup.config.ts && tsc --outDir dist --project tsconfig.json",
    "prebuild": "pnpm clean",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --config ../../eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fidely-ui/fidely-ui",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/fidely-ui/fidely-ui/issues"
  },
  "bin": {
    "fidely": "dist/cli.js"
  },
  "homepage": "https://github.com/fidely-ui/fidely-ui#readme",
  "keywords": [
    "fidely-ui",
    "fidely",
    "cli",
    "theming",
    "component generator",
    "snippet generator",
    "generator"
  ],
  "author": "Justice Chimobi <chimobi.justice@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@inquirer/prompts": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "figlet": "^1.9.4",
    "fs-extra": "^11.3.2",
    "nanospinner": "^1.2.2",
    "package-manager-detector": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20"
  }
}
